{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": [
    {
      "target": "recipes",
      "public": "apps/recipes/build/dist/wasmJs/productionExecutable",
      "rewrites": [{ "source": "/api/**", "function": "api" }]
    },
    {
      "target": "transit",
      "public": "apps/transit/build/dist/wasmJs/productionExecutable",
      "rewrites": [{ "source": "/api/**", "function": "api" }]
    }
  ]
}
